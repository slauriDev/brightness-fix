<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Основной контент -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        
        <LinearLayout
            android:id="@+id/brightnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/brightness_card"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brightness_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text" />

                <TextView
                    android:id="@+id/tvValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <SeekBar
                    android:id="@+id/sliderBrightness"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/brightness_track"
                    android:thumb="@drawable/brightness_thumb"
                    android:splitTrack="false"
                    android:thumbOffset="4dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <ImageButton
                    android:id="@+id/btnOverride"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/lock_button_background"
                    android:src="@drawable/lock_icon"
                    android:scaleType="center"
                    android:padding="12dp"
                    android:contentDescription="@string/fix_brightness"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brightness_description"
                android:textSize="12sp"
                android:textColor="@color/dark_text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rangeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/brightness_card"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/range_label"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text"
                android:gravity="start" />
        
            <LinearLayout
                android:id="@+id/rangeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/rangeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnRange255"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="1–255"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:textColor="@drawable/range_pill_text"
                        android:background="@drawable/range_pill_background"
                        android:backgroundTint="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/btnRange4095"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="1–4095"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:textColor="@drawable/range_pill_text"
                        android:background="@drawable/range_pill_background"
                        android:backgroundTint="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/range_description"
                android:textSize="12sp"
                android:textColor="@color/dark_text_secondary"
                android:gravity="start"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Затемнение -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_dim"
        android:visibility="gone" />

    <!-- Баннер "Нет root" -->
    <LinearLayout
        android:id="@+id/noRootBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:layout_gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_no_root"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_root_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_root_message"
                android:textSize="13sp"
                android:textColor="@color/dark_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnDismiss"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="@string/ok"
                android:textColor="@color/dark_surface_alt" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>