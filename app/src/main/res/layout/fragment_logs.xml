<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/logsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logs_empty"
            android:textSize="13sp"
            android:textColor="@color/dark_text_secondary"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/logsFloatingButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/btnClearContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/settings_card_logs"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/ivClearIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@null"
                android:src="@drawable/ic_clear"
                android:tint="@color/white"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/logs_clear" />

            <TextView
                android:id="@+id/tvClearConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text"
                android:visibility="gone"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/settings_card_logs"
            android:backgroundTint="@color/dark_accent"
            android:src="@drawable/ic_menu_share"
            android:tint="@color/white"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/logs_share" />

    </LinearLayout>

</FrameLayout>
