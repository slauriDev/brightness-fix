<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#FF1C1B1F">

    <TextView
        android:id="@+id/tvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100%"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderBrightness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="100.0"
        android:value="100.0"
        android:stepSize="1.0"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:thumbRadius="12dp"
        app:thumbColor="#FFFFFFFF"
        app:trackHeight="48dp"
        app:trackColorActive="#FFFFFFFF"
        app:trackColorInactive="#33FFFFFF"
        app:haloColor="#33FFFFFF"
        app:haloRadius="20dp"
        app:trackCornerRadius="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Фиксировать яркость"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:layout_marginTop="24dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchOverride"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>